#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "arduino_nano_xl_link_pic32ck2051sg01144-common.overlay"

#include "retained_mem.dtsi"

&pinctrl {
	tcc2_arduino_wo2: tcc2_arduino_wo2 {
		group1 {
			pinmux = <PD11F_TCC2_WO2>;
		};
	};
};

&tcc2 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc2_arduino_wo2>;
	pinctrl-names = "default", "sleep", "arduino";
};

/*
 * ESP8266 AT module on the Connector carrier: sercom1 with D7 as its reset
 * line. The module may not be fitted: the driver neither opens the UART nor
 * drives D7 until the WiFi library brings its interface up
 * (CONFIG_WIFI_ESP_AT_NET_IF_NO_AUTO_START), so sercom1 is Serial2 and D7 a
 * plain pin otherwise.
 */
&sercom1 {
	esp8266: esp8266 {
		compatible = "espressif,esp-at";
		reset-gpios = <&portd 11 GPIO_ACTIVE_LOW>;
	};
};

/ {
	log_uarts: log_uarts {
		compatible = "zephyr,log-uart";
		uarts = <&sercom6 &board_cdc_acm_uart>;
	};

	chosen {
		zephyr,log-uart = &log_uarts;
		zephyr,console = &sercom6;
	};

	zephyr,user {
		/*
		 * ESP8266 firmware update through the WiFi SerialBridge example: USB
		 * DTR drives GPIO0 (D2) and RTS drives reset (D7), as on the usual
		 * esptool auto-reset circuit.
		 */
		coprocessor-serial = <&sercom1>;
		coprocessor-boot-gpios = <&portc 19 GPIO_ACTIVE_LOW>;
		coprocessor-reset-gpios = <&portd 11 GPIO_ACTIVE_LOW>;

		serials = <&sercom6>, <&sercom1>, <&sercom0>;

		pwm-pin-gpios = <&portc 19 0>,
				<&portc 20 0>,
				<&portc 15 0>,
				<&portc 16 0>,
				<&portc 17 0>,
				<&porta 21 0>,
				<&porta 20 0>,
				<&portb 11 0>,
				<&portd 11 0>,
				<&porta 23 0>,
				<&portb 24 0>;

		pwms = <&tcc1 4 PWM_HZ(500) 0>,
		       <&tcc1 5 PWM_HZ(500) 0>,
		       <&tcc1 0 PWM_HZ(500) PWM_POLARITY_INVERTED>,
		       <&tcc1 1 PWM_HZ(500) PWM_POLARITY_INVERTED>,
		       <&tcc1 2 PWM_HZ(500) PWM_POLARITY_INVERTED>,
		       <&tcc4 1 PWM_HZ(500) 0>,
		       <&tcc4 0 PWM_HZ(500) 0>,
		       <&tcc3 0 PWM_HZ(500) 0>,
		       <&tcc2 2 PWM_HZ(500) 0>,
		       <&tcc5 1 PWM_HZ(500) 0>,
		       <&tcc6 1 PWM_HZ(500) 0>;
	};
};
