+/// What survives a reset of the board, and what one boot with the Arduino
+/// hooks did.  Mirrors `struct arduino_boot_io` in csupport/arduino_zephyr.
+#[cfg(feature = "arduino-hooks")]
+#[repr(C)]
+#[derive(Debug, Default, Clone, Copy)]
+pub struct ArduinoBootIo {
+    /// Retention boot mode (1 = bootloader), kept across resets.
+    pub boot_mode: i32,
+    /// Double-tap cookie in retained RAM, kept across resets.
+    pub cookie: [u8; 4],
+    /// This reset came from the reset pin.
+    pub pin_reset: u8,
+    /// The reset button is pressed again while the double-tap window is open.
+    pub press_in_window: u8,
+    pub dfu_entered: u8,
+    pub rebooted: u8,
+    pub window_slept: u8,
+    pub reset_in_window: u8,
+    pub pad: [u8; 2],
+    /// boot_go() result, -1 when it did not run.
+    pub boot_rc: i32,
+}
+
+/// One boot in the Zephyr port's order with the Arduino hooks: double tap,
+/// boot_go_hook(), boot_go(), and the no-bootable-image action hook.
+/// Returns false when the board was reset before boot_go() returned.
+#[cfg(feature = "arduino-hooks")]
+pub fn arduino_boot(multiflash: &mut SimMultiFlash, areadesc: &AreaDesc,
+                    io: &mut ArduinoBootIo) -> bool {
+    init_crypto();
+
+    for (&dev_id, flash) in multiflash.iter_mut() {
+        api::set_flash(dev_id, flash);
+    }
+    let mut sim_ctx = api::CSimContext::default();
+    let mut rsp = api::BootRsp {
+        br_hdr: std::ptr::null(),
+        flash_dev_id: 0,
+        image_off: 0,
+    };
+    let result = unsafe {
+        let adesc = areadesc.get_c();
+        raw::invoke_arduino_boot(&mut sim_ctx as *mut _, adesc.borrow() as *const _,
+                                 &mut rsp as *mut _, io as *mut _)
+    };
+    for &dev_id in multiflash.keys() {
+        api::clear_flash(dev_id);
+    }
+    assert!(result == 0 || result == 1, "unexpected arduino boot result {}", result);
+    result == 0
+}
+
 pub fn boot_load_image_from_flash_to_sram(multiflash: &mut SimMultiFlash, areadesc: &AreaDesc) -> bool {
     init_crypto();
 
