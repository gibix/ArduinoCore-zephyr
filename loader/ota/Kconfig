menuconfig OTA
	bool "Enable sketch and loader updates"
	depends on FILE_SYSTEM || BOOTLOADER_MCUBOOT
	select REBOOT
	help
	  Let the sketch stage an update (ota.h) that is installed on the next
	  boot, by the loader from a file or by MCUboot from its secondary slot.

if OTA

choice OTA_BACKEND
	prompt "Where updates are staged"
	default OTA_BACKEND_MCUBOOT if BOOTLOADER_MCUBOOT
	default OTA_BACKEND_FS

config OTA_BACKEND_FS
	bool "File in a filesystem"
	depends on FILE_SYSTEM
	select RTC if SOC_SERIES_STM32H7X
	help
	  The update is written to OTA_SKETCH_UPDATE_PATH or OTA_LOADER_UPDATE_PATH.
	  The loader installs a sketch update at boot, the mbed bootloader a
	  loader update.

config OTA_BACKEND_MCUBOOT
	bool "MCUboot secondary slot"
	depends on BOOTLOADER_MCUBOOT
	select FLASH_MAP
	select STREAM_FLASH
	# MCUBOOT_IMG_MANAGER is the image manager choice's default.
	select IMG_MANAGER
	select IMG_ERASE_PROGRESSIVELY
	help
	  The update is a full MCUboot image (loader + sketch) written to
	  slot1_partition; MCUboot verifies and installs it on the next boot.

endchoice

if OTA_BACKEND_FS

config OTA_SKETCH_UPDATE_PATH
	string "The path it is looked for ota"
	default "/ota:/UPDATE_SKETCH.BIN"
	help
	  the path that is checked for a sketch new binary

config OTA_SKETCH_TEMP_PATH_POSTFIX
	string "temporary file name postfix for sketch ota not ready"
	default ".TEMP"
	help
	  String that is appended to sketch ota filename when it is still not ready to be loaded,
	  a rename operation is required to make the ota file enabled for next reboot

config OTA_LOADER_UPDATE_PATH
	string "The path it is looked for ota"
	default "/ota:/UPDATE.BIN"
	help
	  the path that is checked for the loader new binary

config OTA_LOADER_TEMP_PATH_POSTFIX
	string "temporary file name postfix for loader ota not ready"
	default "" if SOC_SERIES_STM32H7X
	default ".TEMP"
	help
	  String that is appended to loader ota filename when it is still not ready to be loaded,
	  a rename operation is required to make the ota file enabled for next reboot

config OTA_TRANSCRIPTION_CHUNK_SIZE
	int "The size of the stack allocated chunk in bytes for transcription"
	default 1024
	help
	  The size of the stack allocated chunk in bytes for ota file transcription

endif # OTA_BACKEND_FS

module = OTA
module-str = OTA
module-help = Sets log level for OTA
source "subsys/logging/Kconfig.template.log_config"

endif
